{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Nombre de instancia de Data Factory",
			"defaultValue": "adf-ucb-transporte-mishel-78321908"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_admisiones')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "srcAdmissions"
						},
						{
							"dataset": {
								"referenceName": "ds_silver_diagnoses",
								"type": "DatasetReference"
							},
							"name": "srcDiagnoses"
						},
						{
							"dataset": {
								"referenceName": "ds_gold_dim_paciente",
								"type": "DatasetReference"
							},
							"name": "dimPaciente"
						},
						{
							"dataset": {
								"referenceName": "ds_gold_dim_departamento",
								"type": "DatasetReference"
							},
							"name": "dimDepartamento"
						},
						{
							"dataset": {
								"referenceName": "ds_gold_dim_diagnostico",
								"type": "DatasetReference"
							},
							"name": "dimDiagnostico"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_fact_admisiones",
								"type": "DatasetReference"
							},
							"name": "sinkFactAdmisiones"
						}
					],
					"transformations": [
						{
							"name": "diagPrincipal"
						},
						{
							"name": "diagSel"
						},
						{
							"name": "lkPaciente"
						},
						{
							"name": "lkDepartamento"
						},
						{
							"name": "lkDiagAdm"
						},
						{
							"name": "lkDimDiag"
						},
						{
							"name": "calcular"
						},
						{
							"name": "columnas"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcAdmissions",
						"source(output(",
						"          diagnosis_id as integer,",
						"          admission_id as integer,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcDiagnoses",
						"source(output(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> dimPaciente",
						"source(output(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> dimDepartamento",
						"source(output(",
						"          diagnostico_key as integer,",
						"          codigo_icd as string,",
						"          descripcion_patologia as string,",
						"          nivel_severidad as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> dimDiagnostico",
						"srcDiagnoses aggregate(groupBy(admission_id),",
						"     icd = first(icd_code),",
						"          sev = first(iif(isNull(severity),'Unknown',severity))) ~> diagPrincipal",
						"diagPrincipal select(mapColumn(",
						"          diag_adm_id = admission_id,",
						"          icd,",
						"          sev",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> diagSel",
						"srcAdmissions, dimPaciente lookup(patient_id == patient_id_bk,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkPaciente",
						"lkPaciente, dimDepartamento lookup(department == nombre_departamento,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkDepartamento",
						"lkDepartamento, diagSel lookup(admission_id == diag_adm_id,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkDiagAdm",
						"lkDiagAdm, dimDiagnostico lookup(icd == codigo_icd",
						"     && sev == nivel_severidad,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkDimDiag",
						"lkDimDiag derive(diagnostico_key = coalesce(diagnostico_key, -1),",
						"          fecha_ingreso_key = toInteger(toString(admission_date,'yyyyMMdd')),",
						"          fecha_alta_key = toInteger(toString(discharge_date,'yyyyMMdd')),",
						"          dias_estancia = iif(discharge_date >= admission_date, toInteger((toLong(toTimestamp(toString(discharge_date,'yyyy-MM-dd'),'yyyy-MM-dd')) - toLong(toTimestamp(toString(admission_date,'yyyy-MM-dd'),'yyyy-MM-dd'))) / 86400000), toInteger(null())),",
						"          medico_id = attending_doctor_id,",
						"          conteo_admisiones = 1) ~> calcular",
						"calcular select(mapColumn(",
						"          admission_id_bk = admission_id,",
						"          paciente_key,",
						"          departamento_key,",
						"          diagnostico_key,",
						"          fecha_ingreso_key,",
						"          fecha_alta_key,",
						"          medico_id,",
						"          dias_estancia,",
						"          conteo_admisiones",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> columnas",
						"columnas sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkFactAdmisiones"
					]
				}
			},
			"dependsOn": []
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_fact_facturacion')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_billing",
								"type": "DatasetReference"
							},
							"name": "srcBilling"
						},
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "srcAdmissions"
						},
						{
							"dataset": {
								"referenceName": "ds_gold_dim_paciente",
