					],
					"transformations": [
						{
							"name": "admSel"
						},
						{
							"name": "lkAdmision"
						},
						{
							"name": "lkPaciente"
						},
						{
							"name": "lkDepartamento"
						},
						{
							"name": "lkServicio"
						},
						{
							"name": "calcular"
						},
						{
							"name": "columnas"
						}
					],
					"scriptLines": [
						"source(output(",
						"          billing_id as integer,",
						"          admission_id as integer,",
						"          charge_type as string,",
						"          amount as decimal(12,2),",
						"          payment_status as string,",
						"          payment_date as date",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcBilling",
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcAdmissions",
						"source(output(",
						"          paciente_key as integer,",
						"          patient_id_bk as integer,",
						"          nombre_completo as string,",
						"          genero as string,",
						"          fecha_nacimiento as date,",
						"          rango_etario as string,",
						"          correo_electronico as string,",
						"          direccion as string,",
						"          proveedor_seguro as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> dimPaciente",
						"source(output(",
						"          departamento_key as integer,",
						"          nombre_departamento as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> dimDepartamento",
						"source(output(",
						"          servicio_cargo_key as integer,",
						"          tipo_cargo as string,",
						"          estado_pago as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> dimServicio",
						"srcAdmissions select(mapColumn(",
						"          adm_id = admission_id,",
						"          patient_id,",
						"          department",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> admSel",
						"srcBilling, admSel lookup(admission_id == adm_id,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkAdmision",
						"lkAdmision, dimPaciente lookup(patient_id == patient_id_bk,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkPaciente",
						"lkPaciente, dimDepartamento lookup(department == nombre_departamento,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkDepartamento",
						"lkDepartamento, dimServicio lookup(charge_type == tipo_cargo",
						"     && payment_status == estado_pago,",
						"     multiple: false,",
						"     pickup: 'any',",
						"     broadcast: 'auto')~> lkServicio",
						"lkServicio derive(fecha_pago_key = toInteger(toString(payment_date,'yyyyMMdd')),",
						"          monto_facturado = amount,",
						"          conteo_transacciones = 1) ~> calcular",
						"calcular select(mapColumn(",
						"          billing_id_bk = billing_id,",
						"          admission_id_bk = admission_id,",
						"          paciente_key,",
						"          departamento_key,",
						"          servicio_cargo_key,",
						"          fecha_pago_key,",
						"          monto_facturado,",
						"          conteo_transacciones",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> columnas",
						"columnas sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkFactFacturacion"
