		{
			"name": "[concat(parameters('factoryName'), '/df_gold_dim_departamento')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_admissions",
								"type": "DatasetReference"
							},
							"name": "srcSilverAdmissions"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_dim_departamento",
								"type": "DatasetReference"
							},
							"name": "sinkDimDepartamento"
						}
					],
					"transformations": [
						{
							"name": "distintos"
						},
						{
							"name": "columnas"
						}
					],
					"scriptLines": [
						"source(output(",
						"          admission_id as integer,",
						"          patient_id as integer,",
						"          admission_date as date,",
						"          discharge_date as date,",
						"          department as string,",
						"          attending_doctor_id as integer",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcSilverAdmissions",
						"srcSilverAdmissions aggregate(groupBy(department),",
						"     cantidad = count()) ~> distintos",
						"distintos select(mapColumn(",
						"          nombre_departamento = department",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> columnas",
						"columnas sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkDimDepartamento"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_silver_admissions')]",
				"[concat(variables('factoryId'), '/datasets/ds_gold_dim_departamento')]"
			]
		},
		{
			"name": "[concat(parameters('factoryName'), '/df_gold_dim_diagnostico')]",
			"type": "Microsoft.DataFactory/factories/dataflows",
			"apiVersion": "2018-06-01",
			"properties": {
				"folder": {
					"name": "gold"
				},
				"type": "MappingDataFlow",
				"typeProperties": {
					"sources": [
						{
							"dataset": {
								"referenceName": "ds_silver_diagnoses",
								"type": "DatasetReference"
							},
							"name": "srcSilverDiagnoses"
						}
					],
					"sinks": [
						{
							"dataset": {
								"referenceName": "ds_gold_dim_diagnostico",
								"type": "DatasetReference"
							},
							"name": "sinkDimDiagnostico"
						}
					],
					"transformations": [
						{
							"name": "severidad"
						},
						{
							"name": "distintos"
						},
						{
							"name": "columnas"
						}
					],
					"scriptLines": [
						"source(output(",
						"          diagnosis_id as integer,",
						"          admission_id as integer,",
						"          icd_code as string,",
						"          diagnosis_description as string,",
						"          severity as string",
						"     ),",
						"     allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     isolationLevel: 'READ_UNCOMMITTED',",
						"     format: 'table') ~> srcSilverDiagnoses",
						"srcSilverDiagnoses derive(sev = iif(isNull(severity),'Unknown',severity)) ~> severidad",
						"severidad aggregate(groupBy(icd_code,",
						"          sev),",
						"     descripcion = first(diagnosis_description)) ~> distintos",
						"distintos select(mapColumn(",
						"          codigo_icd = icd_code,",
						"          descripcion_patologia = descripcion,",
						"          nivel_severidad = sev",
						"     ),",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true) ~> columnas",
						"columnas sink(allowSchemaDrift: true,",
						"     validateSchema: false,",
						"     deletable:false,",
						"     insertable:true,",
						"     updateable:false,",
						"     upsertable:false,",
						"     format: 'table',",
						"     skipDuplicateMapInputs: true,",
						"     skipDuplicateMapOutputs: true,",
						"     errorHandlingOption: 'stopOnFirstError') ~> sinkDimDiagnostico"
					]
				}
			},
			"dependsOn": [
				"[concat(variables('factoryId'), '/datasets/ds_silver_diagnoses')]",
				"[concat(variables('factoryId'), '/datasets/ds_gold_dim_diagnostico')]"
			]
		},
