{
	"name": "df_silver_billing",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_billing",
						"type": "DatasetReference"
					},
					"name": "srcBilling"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "srcSilverAdmissions"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_billing",
						"type": "DatasetReference"
					},
					"name": "sinkSilverBilling"
				}
			],
			"transformations": [
				{
					"name": "limpiar"
				},
				{
					"name": "sinMontoNulo"
				},
				{
					"name": "admisionExiste"
				}
			],
			"scriptLines": [
				"source(output(",
				"          billing_id as string,",
				"          admission_id as string,",
				"          charge_type as string,",
				"          amount as string,",
				"          payment_status as string,",
				"          payment_date as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcBilling",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcSilverAdmissions",
				"srcBilling derive(billing_id = toInteger(trim(billing_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          charge_type = iif(isNull(charge_type),'Unknown',trim(charge_type)),",
				"          amount = abs(toDecimal(regexReplace(amount,'[^0-9.\\\\-]',''),12,2)),",
				"          payment_status = initCap(lower(trim(payment_status))),",
				"          payment_date = case(regexMatch(trim(payment_date),'^\\\\d{4}-\\\\d{2}-\\\\d{2}$'), toDate(trim(payment_date),'yyyy-MM-dd'), regexMatch(trim(payment_date),'^\\\\d{2}/\\\\d{2}/\\\\d{4}$'), toDate(trim(payment_date),'MM/dd/yyyy'), regexMatch(trim(payment_date),'^\\\\d{2}-\\\\d{2}-\\\\d{2}$'), toDate(trim(payment_date),'MM-dd-yy'), regexMatch(trim(payment_date),'^\\\\d{2}-[A-Za-z]{3}-\\\\d{4}$'), toDate(trim(payment_date),'dd-MMM-yyyy'), toDate(trim(payment_date),'MMMM dd, yyyy'))) ~> limpiar",
				"limpiar filter(!isNull(amount)) ~> sinMontoNulo",
				"sinMontoNulo, srcSilverAdmissions exists(limpiar@admission_id == srcSilverAdmissions@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> admisionExiste",
				"admisionExiste sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          billing_id as integer,",
				"          admission_id as integer,",
				"          charge_type as string,",
				"          amount as decimal(12,2),",
				"          payment_status as string,",
				"          payment_date as date",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkSilverBilling"
			]
		}
	}
}