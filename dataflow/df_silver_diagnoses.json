{
	"name": "df_silver_diagnoses",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "ds_bronze_diagnoses",
						"type": "DatasetReference"
					},
					"name": "srcDiagnoses"
				},
				{
					"dataset": {
						"referenceName": "ds_silver_admissions",
						"type": "DatasetReference"
					},
					"name": "srcSilverAdmissions"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "ds_silver_diagnoses",
						"type": "DatasetReference"
					},
					"name": "sinkSilverDiagnoses"
				}
			],
			"transformations": [
				{
					"name": "limpiar1"
				},
				{
					"name": "limpiar2"
				},
				{
					"name": "admisionExiste"
				}
			],
			"scriptLines": [
				"source(output(",
				"          diagnosis_id as string,",
				"          admission_id as string,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcDiagnoses",
				"source(output(",
				"          admission_id as integer,",
				"          patient_id as integer,",
				"          admission_date as date,",
				"          discharge_date as date,",
				"          department as string,",
				"          attending_doctor_id as integer",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> srcSilverAdmissions",
				"srcDiagnoses derive(diagnosis_id = toInteger(trim(diagnosis_id)),",
				"          admission_id = toInteger(trim(admission_id)),",
				"          icd_code = replace(upper(trim(split(icd_code, ',')[1])),'-','.'),",
				"          severity = initCap(lower(trim(severity)))) ~> limpiar1",
				"limpiar1 derive(icd_code = iif(instr(icd_code,'.')==0 && length(icd_code)>3, concat(left(icd_code,3),'.',substring(icd_code,4)), icd_code)) ~> limpiar2",
				"limpiar2, srcSilverAdmissions exists(limpiar1@admission_id == srcSilverAdmissions@admission_id,",
				"     negate:false,",
				"     broadcast: 'auto')~> admisionExiste",
				"admisionExiste sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          diagnosis_id as integer,",
				"          admission_id as integer,",
				"          icd_code as string,",
				"          diagnosis_description as string,",
				"          severity as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError') ~> sinkSilverDiagnoses"
			]
		}
	}
}